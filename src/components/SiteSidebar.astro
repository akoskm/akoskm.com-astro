---
import { LISTED_APPS } from "@data/apps";
import products from "@data/products";
import { BITSY_TAGLINE, BITSY_URL } from "@data/promos";
import BitsyForm from "./BitsyForm.astro";
import Icon from "./Icon.astro";
import ProfilePhoto from "./ProfilePhoto.astro";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;

const nav = [
  { href: "/", label: "Home", card: "home", icon: "home" },
  { href: "/posts/", label: "Writing", card: "writing", icon: "pen-line" },
  {
    href: "/newsletter/",
    label: "Newsletter",
    card: "newsletter",
    icon: "newspaper",
  },
  { href: "/apps/", label: "Apps", card: "apps", icon: "blocks" },
  { href: "/books/", label: "Books", card: "books", icon: "book-open" },
  { href: "/about/", label: "About", card: "about", icon: "user" },
  { href: "/search/", label: "Search", card: "search", icon: "search" },
] as const;

function current(href: string): boolean {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(href);
}

const books = ["rtl-crash-course", "mcp-crash-course", "hooks"].map(
  key => products[key as keyof typeof products]
);
---

<aside id="site-drawer" class="site-sidebar" data-site-drawer>
  <div class="drawer-head">
    <a
      class="identity"
      href="/"
      data-promo-card="sidebar-home"
      data-promo-post={path}
      data-promo-destination="nav"
    >
      <ProfilePhoto size={64} />
      <span>
        <span class="site-name" lang="hu"
          >Ákos Kőműves
          <span class="phonetic" lang="en" aria-label="pronounced AH-kosh"
            >(AH-kosh)</span
          ></span
        >
        <span class="bio">I build apps and write Bitsy.</span>
      </span>
    </a>
    <button
      class="drawer-close focus-outline"
      type="button"
      data-drawer-close
      aria-label="Close menu"
    >
      <Icon name="x" />
    </button>
  </div>

  <nav aria-label="Site">
    <ul>
      {
        nav.map(item => (
          <li>
            <a
              href={item.href}
              aria-current={current(item.href) ? "page" : undefined}
              data-promo-card={`sidebar-${item.card}`}
              data-promo-post={path}
              data-promo-destination="nav"
            >
              <Icon name={item.icon} />
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="side-block">
    <h2 class="side-label">Bitsy</h2>
    <p class="side-copy">
      {BITSY_TAGLINE}
    </p>
    <BitsyForm post={path} id="bitsy-email-sidebar" compact />
    <a
      class="side-inline"
      href={BITSY_URL}
      data-promo-card="sidebar-bitsy"
      data-promo-post={path}
      data-promo-destination="read"
      rel="noopener noreferrer"
      target="_blank"
    >
      Read it on Substack
      <Icon name="arrow-up-right" size={16} />
    </a>
  </div>

  <div class="side-block">
    <h2 class="side-label">Apps</h2>
    <ul class="app-list">
      {
        LISTED_APPS.map(app => (
          <li>
            <a
              href={app.href}
              target={app.external ? "_blank" : undefined}
              rel={app.external ? "noopener noreferrer" : undefined}
              data-promo-card={`sidebar-${app.name.toLowerCase().replace(/\s+/g, "-")}`}
              data-promo-post={path}
              data-promo-destination="app"
            >
              <img src={app.icon} alt="" width="40" height="40" />
              <span>
                <strong>{app.name}</strong>
                <span>{app.summary}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="side-block">
    <h2 class="side-label">
      <a
        href="/books/"
        data-promo-card="sidebar-books"
        data-promo-post={path}
        data-promo-destination="books"
      >
        Books
      </a>
    </h2>
    <ul class="book-list">
      {
        books.map(book => (
          <li>
            <a
              href="/books/"
              data-promo-card="sidebar-books"
              data-promo-post={path}
              data-promo-destination="books"
            >
              <img src={book.image} alt={book.title} width="56" height="84" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="side-block side-contact">
    <a
      class="hire-me-btn side-hire"
      href="/hire-me/"
      data-promo-card="sidebar-hire"
      data-promo-post={path}
      data-promo-destination="hire"
    >
      Hire me
    </a>
    <a
      href="mailto:hello@akoskm.com"
      data-promo-card="sidebar-contact"
      data-promo-post={path}
      data-promo-destination="email"
    >
      <Icon name="mail" size={16} />
      hello@akoskm.com
    </a>
    <p class="socials">
      <a
        href="https://x.com/akoskm"
        data-promo-card="sidebar-x"
        data-promo-post={path}
        data-promo-destination="x"
        rel="noopener noreferrer"
        target="_blank"
      >
        <Icon name="x" size={16} />
        X @akoskm
      </a>
      <a
        href="https://github.com/akoskm"
        data-promo-card="sidebar-github"
        data-promo-post={path}
        data-promo-destination="github"
        rel="noopener noreferrer"
        target="_blank"
      >
        <Icon name="github" size={16} />
        GitHub
      </a>
    </p>
    <ThemeToggle />
  </div>
</aside>

<style>
  .site-sidebar {
    background: rgb(var(--color-card));
    color: rgb(var(--color-text-base));
    padding: 1.25rem 1.1rem 2rem;
  }
  .drawer-head {
    display: flex;
    align-items: flex-start;
    gap: 0.25rem;
  }
  .identity {
    display: flex;
    flex: 1;
    gap: 0.75rem;
    align-items: center;
    min-width: 0;
    text-decoration: none;
  }
  .drawer-close {
    display: none;
  }
  .site-name,
  .bio {
    display: block;
  }
  .site-name {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    line-height: 1.15;
  }
  .bio {
    margin-top: 0.25rem;
    font-size: 0.85rem;
    opacity: 0.75;
  }
  nav ul {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
  }
  nav a {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.28rem 0 0.28rem 0.7rem;
    border-left: 2px solid transparent;
    text-decoration: none;
    font-weight: 500;
  }
  nav a[aria-current="page"] {
    border-left-color: rgb(var(--color-accent));
    color: rgb(var(--color-accent));
  }
  .side-block {
    margin-top: 1.35rem;
  }
  .side-label,
  .side-label a {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .side-copy {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    line-height: 1.4;
  }
  .side-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.35rem;
    font-size: 0.85rem;
    text-underline-offset: 3px;
  }
  .app-list,
  .book-list {
    list-style: none;
    margin: 0.55rem 0 0;
    padding: 0;
  }
  .app-list a {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    margin-top: 0.65rem;
    text-decoration: none;
  }
  .app-list img {
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 0.55rem;
    object-fit: cover;
  }
  .app-list strong,
  .app-list span span {
    display: block;
  }
  .app-list span span {
    margin-top: 0.1rem;
    font-size: 0.8rem;
    line-height: 1.35;
    color: rgb(var(--color-text-muted));
  }
  .book-list {
    display: flex;
    gap: 0.5rem;
  }
  .book-list img {
    width: 56px;
    height: 84px;
    object-fit: cover;
    border-radius: 0.2rem;
  }
  .side-hire {
    display: inline-block;
    margin-bottom: 0.55rem;
    border-radius: 999px;
    background: rgb(var(--color-accent-fill));
    padding: 0.45rem 0.9rem;
    color: rgb(var(--color-on-accent));
    font-weight: 600;
    text-decoration: none;
  }
  .side-contact > a[href^="mailto:"] {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 0.45rem;
    font-size: 0.9rem;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .theme-toggle {
    margin-top: 0.8rem;
  }
  @media (max-width: 1023px) {
    .theme-toggle {
      display: none;
    }
    .drawer-head {
      position: sticky;
      top: 0;
      z-index: 2;
      margin: -1.25rem -1.1rem 0;
      padding: 0.85rem 0.7rem 0.75rem 1.1rem;
      background: rgb(var(--color-card));
    }
    .drawer-close {
      display: inline-flex;
      flex: none;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      color: rgb(var(--color-text-base));
    }
    .drawer-close svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
    }
  }
</style>
