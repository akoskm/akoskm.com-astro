---
import { Picture } from "astro:assets";
import avatar from "../assets/akoskm.jpg";

interface Props {
  size?: number;
  shape?: "circle" | "square";
  alt?: string;
}

const { size = 64, shape = "circle", alt = "Ákos Kőműves" } = Astro.props;
---

<span
  class:list={["profile-photo", shape === "square" && "is-square"]}
  style={`width: ${size}px; height: ${size}px`}
>
  <Picture
    src={avatar}
    formats={["avif", "webp"]}
    alt={alt}
    width={size}
    height={size}
    densities={[1, 2]}
  />
</span>

<style>
  .profile-photo {
    display: block;
    flex: none;
    line-height: 0;
  }
  .profile-photo :global(picture) {
    display: block;
    line-height: 0;
  }
  .profile-photo :global(img) {
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: 999px;
    object-fit: cover;
    box-shadow: 0 0 0 2px rgb(var(--color-accent-fill));
  }
  .is-square :global(img) {
    border-radius: 0.7rem;
  }
</style>
