---
import { LISTED_APPS } from "@data/apps";
import products from "@data/products";
import Icon from "./Icon.astro";

const path = Astro.url.pathname;
const books = [
  "mcp-crash-course",
  "rtl-crash-course",
  "pwa",
  "openAi",
  "portfolio",
].map(key => products[key as keyof typeof products]);
---

<div class="project-strip lg:hidden">
  <h2><Icon name="blocks" size={16} /> Apps</h2>
  <ul class="app-grid">
    {
      LISTED_APPS.map(app => (
        <li>
          <a
            href={app.href}
            target={app.external ? "_blank" : undefined}
            rel={app.external ? "noopener noreferrer" : undefined}
            data-promo-card={`sidebar-${app.name.toLowerCase().replace(/\s+/g, "-")}`}
            data-promo-post={path}
            data-promo-destination="app"
          >
            <img src={app.icon} alt="" width="48" height="48" />
            <span>
              <strong>{app.name}</strong>
              <span>{app.summary}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <h2><Icon name="book-open" size={16} /> Books</h2>
  <ul class="book-strip">
    {
      books.map(book => (
        <li>
          <a
            href="/books/"
            data-promo-card="sidebar-books"
            data-promo-post={path}
            data-promo-destination="books"
          >
            <img src={book.image} alt={book.title} width="72" height="108" />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .project-strip {
    margin: 1.5rem 0 0.5rem;
  }
  .project-strip h2 {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 1rem 0 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .project-strip ul {
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
    max-width: 100%;
  }
  .app-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    overflow: visible;
  }
  .project-strip a {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    min-width: 0;
    padding: 0.75rem;
    border-radius: 0.75rem;
    background: rgb(var(--color-card));
    text-decoration: none;
  }
  .app-grid a {
    height: 100%;
  }
  .app-grid a > span {
    min-width: 0;
  }
  @container home-projects (min-width: 900px) {
    .app-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .project-strip img {
    width: 48px;
    height: 48px;
    border-radius: 0.6rem;
    object-fit: cover;
  }
  .book-strip {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
  }
  .book-strip a {
    min-width: 0;
    width: auto;
    flex: none;
    padding: 0;
    background: transparent;
  }
  .book-strip img {
    width: 72px;
    height: 108px;
    border-radius: 0.25rem;
    object-fit: cover;
  }
  .project-strip strong,
  .project-strip span span {
    display: block;
  }
  .project-strip span span {
    margin-top: 0.15rem;
    font-size: 0.85rem;
    color: rgb(var(--color-text-muted));
  }
</style>
