---
import { BITSY_EMBED_URL, BITSY_URL } from "@data/promos";

export interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<aside class="my-8 rounded-lg border border-skin-line bg-skin-card p-4">
  <p class="text-xs uppercase tracking-wide opacity-70">Newsletter</p>
  <h2 class="mt-1 text-lg font-semibold">Bitsy</h2>
  <p class="mt-2 text-sm">
    A free weekly newsletter for developers. I write about what I'm building and
    what I had to figure out to ship it. One email a week.
  </p>
  <div class="mt-4 overflow-hidden rounded-md bg-white">
    <iframe
      src={BITSY_EMBED_URL}
      title="Subscribe to Bitsy"
      class="block h-[320px] w-full border-0"
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
  <p class="mt-3 text-sm">
    <a
      href={BITSY_URL}
      class="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
      data-promo-card="bitsy-signup"
      data-promo-post={slug}
      data-promo-destination="read"
      rel="noopener noreferrer"
      target="_blank"
    >
      Read it on Substack
    </a>
  </p>
</aside>
