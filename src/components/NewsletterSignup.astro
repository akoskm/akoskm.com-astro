---
import { BITSY_SUBSCRIBE_URL, BITSY_URL } from "@data/promos";

export interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<aside class="my-8 rounded-lg border border-skin-line bg-skin-card p-4">
  <p class="text-xs uppercase tracking-wide opacity-70">Newsletter</p>
  <h2 class="mt-1 text-lg font-semibold">Bitsy</h2>
  <p class="mt-2 text-sm">
    A free weekly newsletter for developers. I write about what I'm building and
    what I had to figure out to ship it. One email a week.
  </p>
  <form
    class="bitsy-form mt-4"
    action="/.netlify/functions/subscribe"
    method="post"
    data-bitsy-signup
    data-post={slug}
    data-fallback={BITSY_SUBSCRIBE_URL}
  >
    <p id="bitsy-subscribed" class="bitsy-success text-sm" role="status">
      Check your inbox to confirm
    </p>
    <div data-bitsy-fields>
      <p class="bitsy-honeypot" aria-hidden="true">
        <label>
          Company
          <input name="company" tabindex="-1" autocomplete="off" />
        </label>
      </p>
      <label for="bitsy-email" class="mb-2 block text-sm font-medium">
        Email
      </label>
      <input
        id="bitsy-email"
        class="w-full rounded-lg border border-skin-line bg-skin-fill px-4 py-2 focus:border-skin-accent focus:outline-none"
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
      />
      <input type="hidden" name="post" value={slug} />
      <p data-bitsy-status class="mt-2 min-h-[1.25rem] text-sm" role="status">
      </p>
      <button
        class="hire-me-btn mt-1 rounded-lg bg-skin-accent px-4 py-2 font-medium text-skin-inverted disabled:opacity-60"
        type="submit"
        data-bitsy-button
      >
        Subscribe
      </button>
    </div>
  </form>
  <p class="mt-3 text-sm">
    <a
      href={BITSY_URL}
      class="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
      data-promo-card="bitsy-signup"
      data-promo-post={slug}
      data-promo-destination="read"
      rel="noopener noreferrer"
      target="_blank"
    >
      Read it on Substack
    </a>
  </p>
</aside>

<style>
  .bitsy-success {
    display: none;
  }
  #bitsy-subscribed:target,
  .bitsy-form.is-subscribed .bitsy-success {
    display: block;
  }
  form:has(#bitsy-subscribed:target) [data-bitsy-fields],
  .bitsy-form.is-subscribed [data-bitsy-fields] {
    display: none;
  }
  .bitsy-honeypot {
    position: absolute;
    left: -9999px;
    height: 0;
    width: 0;
    overflow: hidden;
  }
</style>

<script is:inline>
  function bindBitsySignup() {
    const params = new URLSearchParams(window.location.search);
    const subscribed = params.get("subscribed") === "1";
    document.querySelectorAll("form[data-bitsy-signup]").forEach(form => {
      if (subscribed) form.classList.add("is-subscribed");
      if (form.dataset.bound) return;
      form.dataset.bound = "1";
      const button = form.querySelector("[data-bitsy-button]");
      const status = form.querySelector("[data-bitsy-status]");
      const label = button ? button.textContent : "Subscribe";
      form.addEventListener("submit", async event => {
        if (!form.checkValidity()) return;
        event.preventDefault();
        const emailInput = form.querySelector('input[type="email"]');
        const email = emailInput ? emailInput.value.trim() : "";
        if (button) {
          button.disabled = true;
          button.textContent = "Subscribing…";
        }
        if (status) status.textContent = "";
        const company = new FormData(form).get("company");
        let ok = false;
        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify({
              email,
              post: form.dataset.post || "",
              page: window.location.href,
              company: typeof company === "string" ? company : "",
            }),
          });
          const data = await response.json();
          ok = response.ok && data.ok === true;
        } catch {
          ok = false;
        }
        if (ok) {
          form.classList.add("is-subscribed");
          if (typeof window.plausible === "function") {
            window.plausible("Newsletter Signup", {
              props: { post: form.dataset.post || "" },
            });
          }
          return;
        }
        if (status) {
          status.textContent = "Opening Substack to finish signing up.";
        }
        if (typeof window.plausible === "function") {
          window.plausible("Newsletter Signup Fallback", {
            props: { post: form.dataset.post || "" },
          });
        }
        const fallback = new URL(
          form.dataset.fallback || "https://akoskm.substack.com/subscribe"
        );
        fallback.searchParams.set("email", email);
        window.location.assign(fallback.toString());
        if (button) {
          button.disabled = false;
          button.textContent = label;
        }
      });
    });
  }
  bindBitsySignup();
  if (!window.__bitsySignupBound) {
    window.__bitsySignupBound = true;
    document.addEventListener("astro:page-load", bindBitsySignup);
  }
</script>
