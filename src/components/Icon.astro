---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import Blocks from "@lucide/astro/icons/blocks";
import BookOpen from "@lucide/astro/icons/book-open";
import Calendar from "@lucide/astro/icons/calendar";
import Hash from "@lucide/astro/icons/hash";
import House from "@lucide/astro/icons/house";
import Mail from "@lucide/astro/icons/mail";
import Menu from "@lucide/astro/icons/menu";
import Moon from "@lucide/astro/icons/moon";
import Newspaper from "@lucide/astro/icons/newspaper";
import PenLine from "@lucide/astro/icons/pen-line";
import Search from "@lucide/astro/icons/search";
import Send from "@lucide/astro/icons/send";
import Sun from "@lucide/astro/icons/sun";
import User from "@lucide/astro/icons/user";
import X from "@lucide/astro/icons/x";

interface Props {
  name:
    | "arrow-up-right"
    | "blocks"
    | "book-open"
    | "calendar"
    | "github"
    | "hash"
    | "home"
    | "mail"
    | "menu"
    | "moon"
    | "newspaper"
    | "pen-line"
    | "search"
    | "send"
    | "sun"
    | "user"
    | "x";
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
const iconProps = {
  size,
  "stroke-width": 1.75,
  "aria-hidden": "true",
  ...(className ? { class: className } : {}),
};
---

{name === "arrow-up-right" && <ArrowUpRight {...iconProps} />}
{name === "blocks" && <Blocks {...iconProps} />}
{name === "book-open" && <BookOpen {...iconProps} />}
{name === "calendar" && <Calendar {...iconProps} />}
{name === "hash" && <Hash {...iconProps} />}
{name === "home" && <House {...iconProps} />}
{name === "mail" && <Mail {...iconProps} />}
{name === "menu" && <Menu {...iconProps} />}
{name === "moon" && <Moon {...iconProps} />}
{name === "newspaper" && <Newspaper {...iconProps} />}
{name === "pen-line" && <PenLine {...iconProps} />}
{name === "search" && <Search {...iconProps} />}
{name === "send" && <Send {...iconProps} />}
{name === "sun" && <Sun {...iconProps} />}
{name === "user" && <User {...iconProps} />}
{name === "x" && <X {...iconProps} />}
{
  name === "github" && (
    <svg
      class:list={["lucide", "lucide-github", className]}
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
      <path d="M9 18c-4.51 2-5-2-7-2" />
    </svg>
  )
}
