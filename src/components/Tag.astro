---
import Icon from "./Icon.astro";

export interface Props {
  tag: string;
  size?: "sm" | "lg";
}

const { tag, size = "sm" } = Astro.props;
---

<li
  class={`inline-block ${
    size === "sm" ? "my-1 underline-offset-4" : "my-3 mx-1 underline-offset-8"
  }`}
>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class={`${size === "sm" ? "text-sm" : "text-lg"} group font-mono`}
  >
    <Icon name="hash" size={16} />
    <span>{tag}</span>
  </a>
</li>

<style>
  a {
    @apply relative inline-flex items-center gap-1 underline decoration-dashed hover:-top-0.5 hover:text-skin-accent focus-visible:p-1;
  }
</style>
