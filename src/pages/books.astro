---
import ProjectsLayout from "@layouts/ProjectsLayout.astro";
import products from "../data/products.ts";
---

<ProjectsLayout
  frontmatter={{
    title: "Books",
    description:
      "Books and courses by Ákos Kőműves on React Testing Library, custom React hooks, generative AI with React, and cloud-based PWAs.",
  }}
>
  <main class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-12">
      {
        Object.values(products).map(({ title, description, links, image }) => (
          <article class="md:grid-cols-2 grid gap-8 rounded-lg bg-skin-card p-6">
            <div class="flex items-center justify-center">
              {image && (
                <img
                  src={image}
                  alt={`Cover of ${title}`}
                  class="max-h-[400px] w-auto rounded object-contain shadow-lg"
                />
              )}
            </div>
            <div class="prose prose-lg max-w-none">
              <h2 class="mb-4 text-2xl font-semibold">{title}</h2>
              <p class="text-skin-base">{description}</p>
              <div class="mt-6 flex gap-4">
                {links.map(({ href, text }) => (
                  <a
                    href={href}
                    class="inline-flex items-center rounded-lg bg-skin-accent px-4 py-2 text-skin-inverted"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {text}
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </main>
</ProjectsLayout>
