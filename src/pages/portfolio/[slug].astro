---
import { SITE } from "@config";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Icon from "@components/Icon.astro";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const portfolioItems = await getCollection("portfolio");
  return portfolioItems.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();
---

<Layout
  title={`${item.data.title} | ${SITE.title}`}
  description={item.data.description}
>
  <Breadcrumbs />
  <main id="main-content">
    <article class="prose mx-auto mb-28 max-w-3xl px-4 prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">{item.data.title}</h1>
      <p class="mb-4 text-sm text-skin-base opacity-70">
        Client: {
          item.data.clientUrl ? (
            <a
              href={item.data.clientUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="with-icon text-skin-accent hover:underline"
            >
              {item.data.client}
              <Icon name="arrow-up-right" size={16} />
            </a>
          ) : (
            item.data.client
          )
        }
      </p>

      <div class="mb-6 flex flex-wrap gap-2">
        {
          item.data.technologies.map(tech => (
            <span class="rounded border border-skin-line px-2 py-1 font-mono text-xs text-skin-base">
              {tech}
            </span>
          ))
        }
      </div>

      <div class="mb-8 rounded-lg bg-skin-card p-4">
        <h3 class="mb-2 text-lg font-semibold">Key Results</h3>
        <ul class="list-inside list-disc text-sm text-skin-base">
          {item.data.results.map(result => <li>{result}</li>)}
        </ul>
      </div>

      <Content />

      <div class="mt-12 rounded-lg bg-skin-card p-6 text-center">
        <h3 class="mb-2 text-lg font-semibold">
          Ready to build something great?
        </h3>
        <p class="mb-4 text-sm text-skin-base">
          I'm available for consulting, contracting, or fractional CTO roles.
        </p>
        <a
          href="/hire-me"
          class="inline-block rounded-lg bg-skin-accent px-6 py-2 text-skin-inverted"
        >
          Hire me
        </a>
      </div>

      <div class="mt-8">
        <a href="/portfolio" class="text-skin-accent hover:underline">
          &larr; Back to Portfolio
        </a>
      </div>
    </article>
  </main>
</Layout>
