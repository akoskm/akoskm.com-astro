---
import Layout from "@layouts/Layout.astro";
import StreamList from "@components/StreamList.astro";
import { SITE } from "@config";
import { BITSY_TAGLINE } from "@data/promos";
import { loadBitsyFeed, newsletterEntries } from "lib/bitsyFeed";

const issues = await loadBitsyFeed();
const items = newsletterEntries(issues);
---

<Layout
  title={`Newsletter | ${SITE.title}`}
  description={`Bitsy newsletter. ${BITSY_TAGLINE}`}
>
  <main id="main-content">
    <section>
      <h1 class="page-title">Newsletter</h1>
      <p class="lede">{BITSY_TAGLINE}</p>
      <StreamList items={items} />
    </section>
  </main>
</Layout>

<style>
  section {
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }
  .lede {
    margin: 0.5rem 0 1rem;
    max-width: 36rem;
  }
</style>
