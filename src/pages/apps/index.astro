---
import Layout from "@layouts/Layout.astro";
import { SITE } from "@config";
import { LISTED_APPS } from "@data/apps";

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: LISTED_APPS.map((app, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: app.name,
    url: new URL(app.href, SITE.website).href,
  })),
};
---

<Layout
  title={`Apps | ${SITE.title}`}
  description="Apps by Ákos Kőműves: Nummy, SubSub, Geordi Scan, and One Task X."
  extraSchema={itemList}
>
  <main id="main-content">
    <section>
      <h1 class="page-title">Apps</h1>
      <p class="lede">Each one does one job.</p>
      <ul>
        {
          LISTED_APPS.map(app => (
            <li>
              <a
                href={app.href}
                target={app.external ? "_blank" : undefined}
                rel={app.external ? "noopener noreferrer" : undefined}
              >
                <img src={app.icon} alt="" width="72" height="72" />
                <span>
                  <strong>{app.name}</strong>
                  <span>{app.summary}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>

<style>
  section {
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }
  .lede {
    margin-top: 0.45rem;
  }
  ul {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  a {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    padding: 0.9rem;
    border-radius: 0.9rem;
    background: rgb(var(--color-card));
    text-decoration: none;
  }
  img {
    width: 72px;
    height: 72px;
    border-radius: 1rem;
    object-fit: cover;
    flex: none;
  }
  strong,
  span span {
    display: block;
  }
  span span {
    margin-top: 0.2rem;
    color: rgb(var(--color-text-muted));
  }
</style>
