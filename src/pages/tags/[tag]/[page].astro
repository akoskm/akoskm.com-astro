---
import TagPosts from "@layouts/TagPosts.astro";
import { MIN_TAG_POSTS_TO_INDEX } from "@config";
import getUniqueTags from "@utils/getUniqueTags";
import getPostsByTag from "@utils/getPostsByTag";
import getPageNumbers from "@utils/getPageNumbers";
import getPagination from "@utils/getPagination";
import { recordThinTags } from "@utils/thinTags";
import { getAllPosts } from "lib/getAllPosts";
import type { Post } from "lib/schema";

export interface Props {
  tag: string;
  tagName: string;
  tagPosts: Post[];
}

export async function getStaticPaths() {
  const posts = await getAllPosts();

  const tags = getUniqueTags(posts);

  recordThinTags(
    tags
      .filter(
        ({ tag }) => getPostsByTag(posts, tag).length < MIN_TAG_POSTS_TO_INDEX
      )
      .map(({ tag }) => tag)
  );

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);
    const totalPages = getPageNumbers(tagPosts.length);

    return totalPages.map(page => ({
      params: { tag, page },
      props: { tag, tagName, tagPosts },
    }));
  });
}

const { page } = Astro.params;
const { tag, tagName, tagPosts } = Astro.props;

const pagination = getPagination({
  posts: tagPosts,
  page,
});
const postCount = tagPosts.length;
---

<TagPosts {...pagination} {tag} {tagName} {postCount} />
