---
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Tag from "@components/Tag.astro";
import Serie from "@components/Serie.astro";
import getUniqueTags from "@utils/getUniqueTags";
import getUniqueSeries from "@utils/getUniqueSeries";
import { SITE } from "@config";
import { getAllPosts } from "lib/getAllPosts";

const posts = await getAllPosts();
let tags = getUniqueTags(posts);
let series = getUniqueSeries(posts);
---

<Layout
  title={`Tags | ${SITE.title}`}
  description="Browse topics on akoskm.com, from React and TypeScript to testing and AI tooling."
>
  <Main pageTitle="Tags" pageDesc="All the tags used in posts.">
    <ul>
      {tags.map(({ tag }) => <Tag {tag} size="lg" />)}
    </ul>

    <h2 class="mb-4 mt-12 text-2xl font-semibold">Series</h2>
    <ul>
      {series.map(serie => <Serie serie={serie} size="lg" />)}
    </ul>
  </Main>
</Layout>
