---
import Layout from "@layouts/Layout.astro";
import BitsyForm from "@components/BitsyForm.astro";
import ProjectStrip from "@components/ProjectStrip.astro";
import StreamList from "@components/StreamList.astro";
import { getAllPosts } from "lib/getAllPosts";
import { BITSY_TAGLINE } from "@data/promos";
import { loadBitsyFeed, newsletterEntries } from "lib/bitsyFeed";
import postFilter from "@utils/postFilter";
import getSortedPosts from "@utils/getSortedPosts";

const issues = await loadBitsyFeed();
const posts = getSortedPosts((await getAllPosts()).filter(postFilter));
const newsletters = newsletterEntries(issues).slice(0, 5);
const articles = posts.slice(0, 8).map(post => ({
  kind: "article" as const,
  title: post.title,
  href: `/${post.slug}/`,
  publishedAt: post.publishedAt,
  summary: post.brief,
}));
---

<Layout>
  <main id="main-content">
    <section class="home-projects">
      <ProjectStrip />
    </section>
    <section class="home-newsletter">
      <h1>Newsletter</h1>
      <p class="lede">
        {BITSY_TAGLINE}
      </p>
      <StreamList items={newsletters} />
      <p class="stream-more">
        <a href="/newsletter/">All issues →</a>
      </p>
      <div class="home-signup">
        <BitsyForm post="/" id="bitsy-email-home" compact />
      </div>
    </section>
    <section class="home-posts">
      <h2>Posts</h2>
      <StreamList items={articles} showKind={false} />
      <p class="stream-more">
        <a href="/posts/">All articles →</a>
      </p>
    </section>
  </main>
</Layout>

<style>
  .home-newsletter {
    margin-top: 1.5rem;
    padding-top: 1.35rem;
    padding-bottom: 1.35rem;
    border-radius: 0.85rem;
    background: rgb(var(--color-card));
  }
  .home-newsletter h1,
  .home-posts h2 {
    font-size: 2.15rem;
    line-height: 1.05;
  }
  .lede {
    margin-top: 0.45rem;
    max-width: 36rem;
  }
  .stream-more {
    margin-top: 0.35rem;
  }
  .home-signup {
    max-width: 22rem;
    margin-top: 1rem;
  }
  .home-posts {
    padding-top: 1.75rem;
    padding-bottom: 0.5rem;
  }
  .home-projects {
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
  }
  /* The strip is mobile-only in the shared component. On the homepage it is the first block at every width. */
  .home-projects :global(.project-strip) {
    display: block;
  }
</style>
