---
import Layout from "@layouts/Layout.astro";
import ProjectStrip from "@components/ProjectStrip.astro";
import StreamList from "@components/StreamList.astro";
import { getAllPosts } from "lib/getAllPosts";
import {
  loadBitsyFeed,
  newsletterEntries,
  type StreamEntry,
} from "lib/bitsyFeed";
import postFilter from "@utils/postFilter";
import getSortedPosts from "@utils/getSortedPosts";

const issues = await loadBitsyFeed();
const posts = getSortedPosts((await getAllPosts()).filter(postFilter));
const articles: StreamEntry[] = posts.slice(0, 12).map(post => ({
  kind: "article",
  title: post.title,
  href: `/${post.slug}/`,
  publishedAt: post.publishedAt,
  summary: post.brief,
}));
const items = [...newsletterEntries(issues), ...articles]
  .sort((a, b) => Date.parse(b.publishedAt) - Date.parse(a.publishedAt))
  .slice(0, 12);
---

<Layout>
  <main id="main-content">
    <section id="latest">
      <h1>Latest</h1>
      <p class="lede">
        Bitsy most weeks. An article when there's something to ship.
      </p>
      <ProjectStrip />
      <StreamList items={items} />
      <p class="stream-more">
        <a href="/newsletter/">All newsletters</a>
        <a href="/posts/">All articles</a>
      </p>
    </section>
  </main>
</Layout>

<style>
  #latest {
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }
  #latest h1 {
    font-size: 2.4rem;
    line-height: 1;
  }
  .lede {
    margin-top: 0.4rem;
    max-width: 36rem;
  }
  .stream-more {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }
</style>
