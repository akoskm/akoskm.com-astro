---
import { AUTHOR_IMAGE, LOCALE, PERSON_ID, SAME_AS, SITE } from "@config";
import { toIso } from "lib/postMeta";
import SiteSidebar from "@components/SiteSidebar.astro";
import SiteTopbar from "@components/SiteTopbar.astro";
import geistSansWoff2 from "../../node_modules/geist/dist/fonts/geist-sans/Geist-Variable.woff2?url";
import geistMonoWoff2 from "../../node_modules/geist/dist/fonts/geist-mono/GeistMono-Variable.woff2?url";
import "@styles/fonts.css";
import "@styles/base.css";
import "@styles/site.css";
import { ViewTransitions } from "astro:transitions";

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

export interface Props {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: string;
  modDatetime?: string | null;
  scrollSmooth?: boolean;
  /** Post pages are BlogPosting. Everything else is a WebPage. */
  schema?: "BlogPosting" | "WebPage";
  /** Article headline without the site-name suffix. */
  headline?: string;
  robots?: string;
  extraSchema?: Record<string, unknown>;
}

const {
  title = SITE.title,
  author = SITE.author,
  description = SITE.desc,
  ogImage = SITE.ogImage,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  schema = "WebPage",
  headline,
  robots,
  extraSchema,
} = Astro.props;

const metaDescription = description?.trim() || SITE.desc;
const metaAuthor = author?.trim() || SITE.author;

const socialImageURL = new URL(
  ogImage || SITE.ogImage || "og.png",
  Astro.url.origin
).href;

const published = toIso(pubDatetime);
const modified = toIso(modDatetime) || published;

const person = {
  "@type": "Person",
  "@id": PERSON_ID,
  name: SITE.author,
  url: SITE.profile,
  image: new URL(AUTHOR_IMAGE, SITE.website).href,
  sameAs: SAME_AS,
};

const structuredData =
  schema === "BlogPosting"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: headline || title,
        description: metaDescription,
        image: socialImageURL,
        datePublished: published,
        dateModified: modified,
        author: person,
        url: canonicalURL,
        mainEntityOfPage: canonicalURL,
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: title,
        description: metaDescription,
        url: canonicalURL,
        author: person,
      };
---

<!doctype html>
<html lang={LOCALE.lang ?? "en"} class:list={[scrollSmooth && "scroll-smooth"]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={metaDescription} />
    <meta name="author" content={metaAuthor} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      published && (
        <meta property="article:published_time" content={published} />
      )
    }
    {modified && <meta property="article:modified_time" content={modified} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={metaDescription} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    {
      extraSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(extraSchema)}
        />
      )
    }

    <link
      rel="preload"
      href={geistSansWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={geistMonoWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline data-astro-rerun>
      document.documentElement.classList.add("js");
    </script>

    <meta name="theme-color" content="" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={googleSiteVerification}
        />
      )
    }

    <ViewTransitions />

    <script defer src="/toggle-theme.js"></script>
    <script is:inline>
      window.plausible =
        window.plausible ||
        function (...args) {
          (window.plausible.q = window.plausible.q || []).push(args);
        };
      if (!window.__promoTracking) {
        window.__promoTracking = true;
        function promoProps(el) {
          const card = el.getAttribute("data-promo-card");
          const post = el.getAttribute("data-promo-post");
          if (!card || !post) return null;
          const props = { card, post };
          const destination = el.getAttribute("data-promo-destination");
          if (destination) props.destination = destination;
          return props;
        }
        document.addEventListener("click", event => {
          const node = event.target;
          if (!(node instanceof Element)) return;
          const link = node.closest("a[data-promo-card]");
          if (!link) return;
          const props = promoProps(link);
          if (props) window.plausible("Promo Click", { props });
        });
        document.addEventListener("submit", event => {
          const form = event.target;
          if (!(form instanceof HTMLFormElement)) return;
          if (!form.getAttribute("data-promo-card")) return;
          const props = promoProps(form);
          if (props) window.plausible("Promo Click", { props });
        });
      }
    </script>
    <script
      defer
      data-domain="akoskm.com"
      src="https://plausible.akoskm.com/js/script.outbound-links.js"></script>
  </head>
  <body>
    <a id="skip-to-content" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <SiteTopbar />
      <SiteSidebar />
      <div class="site-content">
        <slot />
        <footer class="site-colophon">
          <p lang="hu">{SITE.author}</p>
        </footer>
      </div>
    </div>
    <div class="site-backdrop" data-menu-backdrop hidden></div>
    <script is:inline>
      function drawerEls() {
        return {
          button: document.querySelector("[data-menu-button]"),
          drawer: document.querySelector("[data-site-drawer]"),
          backdrop: document.querySelector("[data-menu-backdrop]"),
        };
      }
      function drawerDesktop() {
        return window.matchMedia("(min-width: 1024px)").matches;
      }
      function drawerItems(drawer) {
        const items = [
          ...drawer.querySelectorAll("a[href], button, input"),
        ].filter(el => !el.disabled && el.getClientRects().length);
        const { button } = drawerEls();
        if (
          button &&
          !button.disabled &&
          button.getClientRects().length &&
          !items.includes(button)
        ) {
          items.unshift(button);
        }
        return items;
      }
      function closeFromOverlay() {
        const { button } = drawerEls();
        setDrawer(false);
        if (button && !drawerDesktop()) button.focus();
      }
      function setDrawer(open) {
        const { button, drawer, backdrop } = drawerEls();
        if (!button || !drawer) return;
        if (drawerDesktop()) open = false;
        button.setAttribute("aria-expanded", open ? "true" : "false");
        button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        drawer.classList.toggle("is-open", open);
        document.body.classList.toggle("menu-open", open);
        if (drawerDesktop() || open) {
          drawer.removeAttribute("inert");
          if (!open) backdrop && backdrop.setAttribute("hidden", "");
          if (open) {
            backdrop && backdrop.removeAttribute("hidden");
            const items = drawerItems(drawer);
            (items[0] || drawer).focus();
          }
          return;
        }
        drawer.setAttribute("inert", "");
        backdrop && backdrop.setAttribute("hidden", "");
      }
      function bindDrawer() {
        const { button, backdrop } = drawerEls();
        if (!button || button.dataset.bound) {
          if (!drawerDesktop()) setDrawer(false);
          return;
        }
        button.dataset.bound = "1";
        button.addEventListener("click", () => {
          setDrawer(button.getAttribute("aria-expanded") !== "true");
        });
        if (backdrop && !backdrop.dataset.bound) {
          backdrop.dataset.bound = "1";
          backdrop.addEventListener("click", closeFromOverlay);
        }
        if (!drawerDesktop()) setDrawer(false);
      }
      if (!window.__siteDrawerBound) {
        window.__siteDrawerBound = true;
        document.addEventListener("keydown", event => {
          const { drawer } = drawerEls();
          if (
            !drawer ||
            !drawer.classList.contains("is-open") ||
            drawerDesktop()
          )
            return;
          if (event.key === "Escape") {
            event.preventDefault();
            closeFromOverlay();
            return;
          }
          if (event.key !== "Tab") return;
          const items = drawerItems(drawer);
          if (!items.length) return;
          const first = items[0];
          const last = items[items.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        });
        window.addEventListener("resize", () => {
          if (drawerDesktop()) setDrawer(false);
        });
        document.addEventListener(
          "click",
          event => {
            const node = event.target;
            if (!(node instanceof Element)) return;
            const link = node.closest("a[href]");
            if (!link || !link.closest("[data-site-drawer]")) return;
            if (drawerDesktop()) return;
            const { button, drawer, backdrop } = drawerEls();
            if (!button || !drawer) return;
            button.setAttribute("aria-expanded", "false");
            button.setAttribute("aria-label", "Open menu");
            drawer.classList.remove("is-open");
            document.body.classList.remove("menu-open");
            if (backdrop) backdrop.setAttribute("hidden", "");
            setTimeout(() => {
              const next = drawerEls().drawer;
              if (next && !next.classList.contains("is-open")) setDrawer(false);
            }, 0);
          },
          true
        );
        document.addEventListener("astro:after-swap", () => {
          document.documentElement.classList.add("js");
          setDrawer(false);
        });
        document.addEventListener("astro:page-load", bindDrawer);
      }
      bindDrawer();
    </script>
  </body>
</html>
