---
import { SITE } from "@config";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import ProfilePhoto from "@components/ProfilePhoto.astro";
import Layout from "./Layout.astro";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
  nameHeading?: string;
  pronunciation?: string;
}

const { frontmatter, nameHeading, pronunciation } = Astro.props;
---

<Layout
  title={`${frontmatter.title} | ${SITE.title}`}
  description={frontmatter.description}
>
  <Breadcrumbs />
  <main id="main-content">
    <section id="about" class="prose mb-28 max-w-3xl prose-img:border-0">
      <div class="about-identity not-prose">
        <ProfilePhoto size={96} />
        <div>
          <h1
            class="text-2xl text-skin-base sm:text-3xl"
            lang={nameHeading ? "hu" : undefined}
          >
            {nameHeading || frontmatter.title}
            {
              pronunciation && (
                <span
                  class="phonetic"
                  lang="en"
                  aria-label={`pronounced ${pronunciation}`}
                >
                  ({pronunciation})
                </span>
              )
            }
          </h1>
        </div>
      </div>
      <slot />
    </section>
  </main>
</Layout>

<style>
  .about-identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    margin: 0 0 1.5rem;
    float: none;
  }
  .about-identity :global(picture),
  .about-identity :global(img) {
    float: none;
    margin: 0;
  }
  .about-identity h1 {
    margin: 0;
    color: rgb(var(--color-text-base));
  }
</style>
