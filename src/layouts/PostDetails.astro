---
import Layout from "@layouts/Layout.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime";
import ShareLinks from "@components/ShareLinks.astro";
import ProductOffer from "@components/ProductOffer.astro";
import PostPromos from "@components/PostPromos.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import RelatedPosts from "@components/RelatedPosts.astro";
import { SITE } from "@config";
import { promosForSlug } from "@data/promos";
import { resolveDescription } from "lib/postMeta";
import { splitPostHtml } from "lib/promoPlacement";
import { getAllPosts, type PostWithContent } from "lib/getAllPosts";
import { experimental_AstroContainer as AstroContainer } from "astro/container";

import "highlight.js/styles/base16/material-darker.min.css";

export interface Props {
  post: PostWithContent;
}

const { post } = Astro.props;
const ContentComponent = post._ContentComponent;

const {
  title,
  seo: { description },
  coverImage: ogImage,
  canonicalUrl,
  publishedAt,
  updatedAt,
  tags,
  slug,
  features,
} = post;

const allPosts = await getAllPosts();

const ogImageUrl = ogImage?.url
  ? ogImage.url
  : `${SITE.website}posts/${slug}.png`;

// For display: use URL as-is (works for both Hashnode URLs and local paths)
const displayImageUrl = ogImageUrl;

// For og:image meta: convert relative paths to absolute URLs
const ogUrl = ogImageUrl.startsWith("http")
  ? ogImageUrl
  : `${SITE.website}${ogImageUrl.replace(/^\//, "")}`;

const promos = promosForSlug(slug);
let beforeHtml = "";
let afterHtml = "";
if (promos.length > 0 && ContentComponent) {
  const container = await AstroContainer.create();
  const html = await container.renderToString(ContentComponent);
  const split = splitPostHtml(html);
  beforeHtml = split.before;
  afterHtml = split.after;
}

const faq = post.faq ?? [];
const faqSchema =
  faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map(item => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
          },
        })),
      }
    : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  headline: title,
  author: SITE.author,
  description: resolveDescription(slug, description, post.brief),
  pubDatetime: publishedAt,
  modDatetime: updatedAt || publishedAt,
  canonicalURL: canonicalUrl || `${SITE.website}${slug}/`,
  ogImage: ogUrl,
  scrollSmooth: true,
  schema: "BlogPosting" as const,
  extraSchema: faqSchema,
};
---

<Layout {...layoutProps}>
  <div class="mx-auto flex w-full max-w-3xl justify-start px-2">
    <button
      class="focus-outline mb-2 mt-8 flex hover:opacity-75"
      onclick="(() => (history.length === 1) ? window.location = '/' : history.back())()"
    >
      <svg xmlns="http://www.w3.org/2000/svg"
        ><path
          d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
        ></path>
      </svg><span>Go back</span>
    </button>
  </div>
  <main id="main-content">
    <img src={displayImageUrl} alt={title} />
    <h1 transition:name={post.slug} class="post-title">{title}</h1>
    <Datetime
      pubDatetime={publishedAt}
      modDatetime={updatedAt}
      size="lg"
      className="my-2"
    />
    <nav id="table-of-contents" class="my-8">
      {
        features.tableOfContents.items.length > 0 && (
          <>
            <h2 class="text-xl font-semibold">Table of Contents</h2>
            <ul>
              {features.tableOfContents.items.map(heading => (
                <li
                  class={[
                    heading.level === 1 ? "ml-2" : "",
                    heading.level === 2 ? "ml-4" : "",
                    heading.level === 3 ? "ml-6" : "",
                    heading.level === 4 ? "ml-8" : "",
                  ].join(" ")}
                >
                  <a href={`#${heading.slug}`} class="hover:underline">
                    {heading.title}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </nav>
    <article id="article" class="mx-auto mt-8 max-w-3xl">
      {
        promos.length > 0 ? (
          <>
            <div class="prose max-w-none" set:html={beforeHtml} />
            <PostPromos slug={slug} />
            <div class="prose max-w-none" set:html={afterHtml} />
          </>
        ) : (
          <div class="prose max-w-none">
            <ContentComponent />
          </div>
        )
      }
    </article>
    <ProductOffer tags={tags} slug={slug} />
    <RelatedPosts currentPost={post} allPosts={allPosts} />

    <ul class="my-8">
      {tags.map(tag => <Tag tag={tag.slug} />)}
    </ul>

    <NewsletterSignup slug={slug} />

    <div
      class="flex flex-col-reverse items-center justify-between gap-6 sm:flex-row-reverse sm:items-end sm:gap-4"
    >
      <button
        id="back-to-top"
        class="focus-outline whitespace-nowrap py-1 hover:opacity-75"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="rotate-90">
          <path
            d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
          ></path>
        </svg>
        <span>Back to Top</span>
      </button>

      <ShareLinks />
    </div>
  </main>
</Layout>

<style>
  main {
    @apply mx-auto w-full max-w-3xl px-4 pb-12;
  }
  main > img {
    padding-bottom: 25px;
  }
  .post-title {
    @apply text-2xl font-semibold text-skin-accent;
  }
</style>

<script is:inline>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-skin-fill";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-skin-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    const winScroll =
      document.body.scrollTop || document.documentElement.scrollTop;
    const height =
      document.documentElement.scrollHeight -
      document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    if (document) {
      const myBar = document.getElementById("myBar");
      if (myBar) {
        myBar.style.width = scrolled + "%";
      }
    }
  }
  document.addEventListener("scroll", updateScrollProgress);

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      if (heading.closest("aside")) continue;
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ml-2 opacity-0 group-hover:opacity-100 focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      const copyButton = document.createElement("button");
      copyButton.className =
        "copy-code absolute right-3 -top-3 rounded bg-skin-card px-2 py-1 text-xs leading-4 text-skin-base font-medium";
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /** Scrolls the document to the top when
   * the "Back to Top" button is clicked. */
  function backToTop() {
    document.querySelector("#back-to-top")?.addEventListener("click", () => {
      document.body.scrollTop = 0; // For Safari
      document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    });
  }
  backToTop();
</script>
