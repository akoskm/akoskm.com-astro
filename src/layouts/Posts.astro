---
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Pagination from "@components/Pagination.astro";
import Card from "@components/Card";
import { SITE } from "@config";
import type { Post } from "lib/schema";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: Post[];
}

const { currentPage, totalPages, paginatedPosts } = Astro.props;
---

<Layout
  title={`Posts | ${SITE.title}`}
  description="All articles by Ákos K on React, TypeScript, testing, Next.js, and shipping AI-powered software."
>
  <Main pageTitle="Posts" pageDesc="All the articles I've posted.">
    <ul>
      {paginatedPosts.map(post => <Card post={post} />)}
    </ul>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={`/posts${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}/`}
    nextUrl={`/posts/${currentPage + 1}/`}
  />
</Layout>
