---
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Card from "@components/Card";
import Pagination from "@components/Pagination.astro";
import { MIN_TAG_POSTS_TO_INDEX, SITE } from "@config";
import type { Post } from "lib/schema";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: Post[];
  tag: string;
  tagName: string;
  postCount: number;
}

const { currentPage, totalPages, paginatedPosts, tag, tagName, postCount } =
  Astro.props;
const robots =
  postCount < MIN_TAG_POSTS_TO_INDEX ? "noindex, follow" : undefined;
---

<Layout
  title={`Tag: ${tagName} | ${SITE.title}`}
  description={`Articles tagged ${tagName} by Ákos Kőműves.`}
  robots={robots}
>
  <Main
    pageTitle={[`Tag:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`All the articles with the tag "${tagName}".`}
  >
    <h1 slot="title" transition:name={tag}>{`Tag:${tag}`}</h1>
    <ul>
      {paginatedPosts.map(post => <Card post={post} />)}
    </ul>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={`/tags/${tag}${
      currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""
    }/`}
    nextUrl={`/tags/${tag}/${currentPage + 1}/`}
  />
</Layout>
